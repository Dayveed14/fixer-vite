# Copy to .env.local for development. On Vercel, set these under
# Project → Settings → Environment Variables (they're baked in at build).

# Backend base URL, no trailing slash. Also used by the sitemap script.
VITE_API_BASE_URL=https://fixer-backend-7mng.onrender.com

# Paystack PUBLIC key (pk_test_… / pk_live_…). Never put the secret key here.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Optional
# VITE_API_TIMEOUT_MS=30000
# MeshCentral web UI the technician opens for remote sessions.
# VITE_MESHCENTRAL_WEB_URL=https://mesh.example.com
